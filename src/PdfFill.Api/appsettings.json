{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "Pdf": {
    "TemplatesDir": "Templates",
    "OutputDir": "../../output",
    "FontFile": "Fonts/DejaVuSans.ttf"
  },
  "Cors": { "Origins": ["http://localhost:5173", "http://localhost:4173"] },
  "Auth": { "Issuer": "pdf-template-service", "TokenHours": 12, "JwtKey": "" },
  "Docs": { "ExposeInternal": false },
  "RateLimiting": { "Enabled": true, "ApiPerMinute": 300, "RenderPerMinute": 60, "AuthPerMinute": 10, "RenderConcurrency": 8, "RenderQueue": 16 },
  "Database": {
    "File": "Data/poc.db",
    "RecreateOnStartup": false
  }
}
